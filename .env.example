# Copie para .env antes de usar o Docker Compose. NUNCA commite o .env.
# Valores abaixo sao EXEMPLOS para desenvolvimento local.
MYSQL_ROOT_PASSWORD=exemplo-local-senha
MYSQL_DATABASE=uniapp_db
MYSQL_PORT=3306

# Chave JWT: no minimo 32 caracteres/bytes. Gere uma aleatoria para producao.
JWT_KEY=EXEMPLO-ONLY-NAO-USAR-EM-PRODUCAO-0123456789abcdef
JWT_ISSUER=UniAppApi
JWT_AUDIENCE=UniAppMobile

API_PORT=5000
ASPNETCORE_ENVIRONMENT=Production
CORS_ORIGIN_0=http://localhost:5000
